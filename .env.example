# Environment variables — AI Customer Support Agent
#
# Copy this file to .env and fill in your actual values locally.
# NEVER commit the .env file.

# Groq API Configuration (Phase 12: Grounded Agent Response Generation)
GROQ_API_KEY=
GROQ_MODEL=

# Optional: target brand configuration (default: AppleSupport)
TARGET_BRAND=AppleSupport

# Production API & Server Configuration (Phase 15: Render & Vercel)
PORT=8000
API_HOST=0.0.0.0
# Comma-separated allowed origins (e.g. for local frontend development and Vercel preview/production domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app
API_DEFAULT_REVIEW_MODE=deterministic
API_REQUEST_TIMEOUT_SECONDS=30.0

