# Environment variables — Hiver AI Customer Support Agent
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file.
#
# API keys will only be needed starting from Phase 6 (reply generation).
# Leave these blank until that phase is reached and approved.

# Google Gemini API key (recommended — has a generous free tier)
GOOGLE_API_KEY=

# OpenAI API key (alternative for reply generation)
OPENAI_API_KEY=

# Optional: set the brand being used (default: AppleSupport)
TARGET_BRAND=AppleSupport
